        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Context\ntitle Diagramma di Contesto (C4 Livello 1) - Framework di Cyber Deception\n\nPerson(User, \&quot;Utente / Attaccante\&quot;, \&quot;Genera traffico web legittimo o tentativi di exploit/brute force.\&quot;)\nSystem_Ext(WAF, \&quot;Google Cloud Armor (WAF)\&quot;, \&quot;Protezione perimetrale deterministica basata su regole e signature (OWASP Top 10).\&quot;)\nSystem(System, \&quot;Framework di Cyber Deception\&quot;, \&quot;Rileva anomalie comportamentali (ATO, Zero-Day) e inietta Honey-URL attivi a runtime.\&quot;)\nSystem_Ext(Infra, \&quot;Infrastruttura Reale\&quot;, \&quot;I servizi applicativi e i backend di produzione autentici dell&#39;azienda.\&quot;)\nSystem_Ext(Obs, \&quot;Piattaforma di Monitoraggio\&quot;, \&quot;Pipeline di ingestion log (Fluent Bit/BigQuery) e telemetria OpenTelemetry.\&quot;)\n\nRel(User, WAF, \&quot;Invia richiesta HTTP/S\&quot;)\nRel(WAF, System, \&quot;Inoltra traffico filtrato\&quot;)\nRel(System, Infra, \&quot;Inoltra traffico legittimo\&quot;, \&quot;HTTP, latenza &lt; 2ms\&quot;)\nRel(System, Obs, \&quot;Invia alert / dati di deception\&quot;, \&quot;JSON / OpenTelemetry, asincrono\&quot;)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ynkgM1FAhVizOsu-Nk8o-2">
