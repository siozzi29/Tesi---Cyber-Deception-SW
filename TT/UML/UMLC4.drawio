  <diagram id="TZJ_2-uBsrJ1gA5MZ5i0" name="L2">
    <mxGraphModel dx="1885" dy="1121" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Container\n    title Diagramma dei Container (C4 Livello 2) - Struttura WAAP Ottimizzata\n\n    System_Ext(WAF, \&quot;Google Cloud Armor (WAF)\&quot;, \&quot;Filtro perimetrale OWASP.\&quot;)\n\n    System_Boundary(SystemBoundary, \&quot;Framework Cyber Deception &amp; IA\&quot;) {\n        %% Componenti Core Online\n        Container(Proxy, \&quot;Reverse Proxy Custom\&quot;, \&quot;Go\&quot;, \&quot;Routing e iniezione esche.\&quot;)\n        ContainerDb(Cache, \&quot;Risk Cache\&quot;, \&quot;Redis\&quot;, \&quot;Lookup score in-memory.\&quot;)\n        Container(AIEngine, \&quot;Servizio Inferenza IA\&quot;, \&quot;FastAPI\&quot;, \&quot;Isolation Forest runtime.\&quot;)\n        \n        %% Componente Deception\n        Container(Trap, \&quot;Honeypot (Trap)\&quot;, \&quot;Go\&quot;, \&quot;Tarpitting e Fake Data.\&quot;)\n        \n        %% Pipeline Asincrona e Offline\n        Container(Obs, \&quot;Observability Pipeline\&quot;, \&quot;Fluent Bit\&quot;, \&quot;Ingestion log asincrona.\&quot;)\n        Container(Filter, \&quot;Data Filter\&quot;, \&quot;Go/Python\&quot;, \&quot;Scrubbing anti-poisoning.\&quot;)\n        Container(MLTrain, \&quot;Addestramento Offline\&quot;, \&quot;Python\&quot;, \&quot;Riaddestramento batch.\&quot;)\n        ContainerDb(Registry, \&quot;Model Registry\&quot;, \&quot;Storage\&quot;, \&quot;Pesi del modello aggiornato.\&quot;)\n    }\n\n    System_Ext(RealInfra, \&quot;Infrastruttura Reale\&quot;, \&quot;Backend di produzione autentici.\&quot;)\n\n    %% Ingresso principale\n    Rel(WAF, Proxy, \&quot;Richiesta HTTP/S\&quot;)\n\n    %% Ciclo Sincrono di Ispezione (Sequenziale e pulito)\n    Rel(Proxy, Cache, \&quot;1. Verifica Score\&quot;)\n    Rel(Cache, AIEngine, \&quot;2. Cache Miss: Richiedi Score\&quot;)\n    Rel(AIEngine, Registry, \&quot;Carica pesi modello\&quot;)\n\n    %% Uscite del traffico (Puntano verso il basso e verso le trappole)\n    Rel(Proxy, RealInfra, \&quot;Flusso Sano (&lt; 2ms)\&quot;)\n    Rel(Proxy, Trap, \&quot;Flusso Alert (Attacco)\&quot;)\n\n    %% Pipeline di monitoraggio e addestramento (Flusso lineare isolato)\n    Rel(Proxy, Obs, \&quot;Log OTel (Async)\&quot;)\n    Rel(Obs, Filter, \&quot;Filtra log grezzi\&quot;)\n    Rel(Filter, MLTrain, \&quot;Dataset bonificato\&quot;)\n    Rel(MLTrain, Registry, \&quot;Push nuovo modello\&quot;)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="U9amFavDQM3QP5FAxLsL-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="1560" width="1640" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="U9amFavDQM3QP5FAxLsL-2" parent="U9amFavDQM3QP5FAxLsL-1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=light-dark(#333333,#cccccc);align=left;verticalAlign=top;spacingLeft=163;" value="Diagramma dei Container (C4 Livello 2) - Struttura WAAP Ottimizzata" vertex="1">
          <mxGeometry height="24" width="826" x="417" y="30" as="geometry" />
