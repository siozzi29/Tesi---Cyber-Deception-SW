        <UserObject label="&lt;div style=&quot;font-size:12px;font-style:italic;&quot;&gt;&amp;lt;&amp;lt;external_system&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:bold;margin-top:4px;&quot;&gt;Google Cloud Armor (WAF)&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:20px;&quot;&gt;Filtro perimetrale OWASP.&lt;/div&gt;" mermaidId="n:WAF" mermaidBaseStyle="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Open Sans,sans-serif;" mermaidBaseValue="&lt;div style=&quot;font-size:12px;font-style:italic;&quot;&gt;&amp;lt;&amp;lt;external_system&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:bold;margin-top:4px;&quot;&gt;Google Cloud Armor (WAF)&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:20px;&quot;&gt;Filtro perimetrale OWASP.&lt;/div&gt;" id="U9amFavDQM3QP5FAxLsL-3">
