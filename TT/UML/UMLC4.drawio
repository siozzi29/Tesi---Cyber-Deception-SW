        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Component\n    title Diagramma dei Componenti (C4 Livello 3) - Interno Reverse Proxy Go\n\n    System_Ext(WAF, \&quot;Google Cloud Armor (WAF)\&quot;, \&quot;Filtro perimetrale edge.\&quot;)\n\n    Container_Boundary(ProxyBoundary, \&quot;Reverse Proxy Custom [Container: Go]\&quot;) {\n        Component(Listener, \&quot;HTTP Listener\&quot;, \&quot;pkg/listener\&quot;, \&quot;Punto d&#39;ingresso delle connessioni TCP/HTTP.\&quot;)\n        Component(Interceptor, \&quot;Security Interceptor\&quot;, \&quot;pkg/interceptor\&quot;, \&quot;Il core orchestratore: coordina i controlli e decide il routing.\&quot;)\n        \n        %% Fila interna orizzontale perfettamente allineata alle uscite inferiori\n        Component(AIClient, \&quot;AI Inference Client\&quot;, \&quot;pkg/aiclient\&quot;, \&quot;Gestisce le chiamate di rete verso l&#39;IA in Python.\&quot;)\n        Component(Injector, \&quot;Honey-URL Injector\&quot;, \&quot;pkg/injector\&quot;, \&quot;Modifica lo stream del DOM iniettando esche invisibili.\&quot;)\n        Component(Router, \&quot;Legit Traffic Router\&quot;, \&quot;pkg/router\&quot;, \&quot;Inoltra il traffico pulito con overhead &lt; 2ms.\&quot;)\n        Component(Telemetry, \&quot;Telemetry Agent\&quot;, \&quot;pkg/telemetry\&quot;, \&quot;Spedisce asincronamente i log JSON a Fluent Bit.\&quot;)\n    }\n\n    %% Sistemi Esterni posizionati esattamente sotto i relativi componenti client\n    System_Ext(AIEngine, \&quot;Servizio Inferenza IA\&quot;, \&quot;Python / FastAPI Backend\&quot;)\n    System_Ext(Trap, \&quot;Honeypot Applicativo\&quot;, \&quot;Go Trap Env\&quot;)\n    System_Ext(RealInfra, \&quot;Infrastruttura Reale\&quot;, \&quot;Backend di Produzione\&quot;)\n    System_Ext(Obs, \&quot;Observability Pipeline\&quot;, \&quot;Fluent Bit Stack\&quot;)\n\n    %% Flusso d&#39;ingresso primario\n    Rel(WAF, Listener, \&quot;Traffico HTTP\&quot;)\n    Rel(Listener, Interceptor, \&quot;Passa payload\&quot;)\n\n    %% Collegamenti interni dall&#39;orchestratore alla fila orizzontale\n    Rel(Interceptor, AIClient, \&quot;Richiede analisi anomalia\&quot;)\n    Rel(Interceptor, Injector, \&quot;Richiede iniezione esche\&quot;)\n    Rel(Interceptor, Router, \&quot;Traffico Sano\&quot;)\n    Rel(Interceptor, Telemetry, \&quot;Dati contesto asincroni\&quot;)\n\n    %% Collegamenti di uscita (Linee verticali e parallele pulite senza incroci)\n    Rel(AIClient, AIEngine, \&quot;API Call: Risk Score\&quot;, \&quot;HTTP/gRPC\&quot;)\n    Rel(Injector, Trap, \&quot;Valutazione: Attacco\&quot;, \&quot;HTTP Routing\&quot;)\n    Rel(Router, RealInfra, \&quot;Inoltro Trasparente\&quot;, \&quot;HTTP/S\&quot;)\n    Rel(Telemetry, Obs, \&quot;Esporta JSON\&quot;, \&quot;Fluent Bit Ingestion\&quot;)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="APXowBNtJEgHI_DdwU7E-54">
